!
! Swap Caps_Lock and Control_L
!
remove Lock = Caps_Lock
remove Control = Control_L
keysym Control_L = Caps_Lock
keysym Caps_Lock = Control_L
add Lock = Caps_Lock
add Control = Control_L

!
! Swap Alt and Windows keys
! this is buggy and doesn't work with emacs
!remove mod1 = Alt_L Alt_R Meta_L
!remove mod4 = Super_R Super_L Hyper_L
!keysym Meta_L = Super_L Super_R Hyper_L
!keysym Alt_L = Super_L Super_R Hyper_L
!keysym Super_L = Alt_L Alt_R Meta_L
!add mod4 = Alt_L Meta_L
!add mod1 = Super_L Hyper_L

!This is an experiment that didn't work out
!remove mod1 = Alt_L
!remove mod4 = Super_L
!keycode 133 = Alt_L
!keycode 64 = Super_L
!add mod1 = Alt_L
!add mod4 = Super_L
